# ---------- App ----------
# URL pública do app (na Vercel use o domínio de produção)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Evolution API (WhatsApp) ----------
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=goodfinance
# Segredo enviado pela Evolution no webhook (?token=...). Gere com: openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=
# Número do WhatsApp conectado na instância (com DDI), usado nos links wa.me
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# ---------- Open Finance (Pluggy — https://dashboard.pluggy.ai) ----------
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Segredo do webhook da Pluggy (?token=...). Gere com: openssl rand -hex 32
PLUGGY_WEBHOOK_SECRET=
# true para mostrar os bancos de teste (sandbox) no widget
NEXT_PUBLIC_PLUGGY_SANDBOX=false

# ---------- Vercel Cron ----------
# A Vercel envia "Authorization: Bearer CRON_SECRET" para /api/cron/sync
CRON_SECRET=
